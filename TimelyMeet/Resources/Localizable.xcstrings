    "app_feedback_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TimelyMeet is continuously evolving based on user feedback. Share your ideas, report issues, or request new features."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TimelyMeet постоянно развивается на основе отзывов пользователей. Делитесь идеями, сообщайте о проблемах или запрашивайте новые функции."
          }
        }
      }
    },
    "app_improvement_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We're constantly working to improve TimelyMeet. Here's what's planned:"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы постоянно работаем над улучшением TimelyMeet. Вот что запланировано:"
          }
        }
      }
    },
    "app_info_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TimelyMeet is a smart macOS application designed to help you never miss an important meeting. It monitors your calendar events and provides timely, customizable notifications with direct access to video conference links."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TimelyMeet — это умное приложение для macOS, призванное помочь вам никогда не пропустить важную встречу. Оно отслеживает события вашего календаря и предоставляет своевременные настраиваемые уведомления с прямым доступом к ссылкам видеоконференций."
          }
        }
      }
    },
    "app_integration_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TimelyMeet integrates with your system calendar to provide enhanced meeting management capabilities. All calendar data is processed locally on your device."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TimelyMeet интегрируется с системным календарем для предоставления расширенных возможностей управления встречами. Все данные календаря обрабатываются локально на вашем устройстве."
          }
        }
      }
    },
